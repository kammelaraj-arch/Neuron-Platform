        "read once",
        "expect no driver error"
      ],
      "expected": "no error"
    }
  ],
  "compatibility": {
    "compute": [
      "compute.pico2w",
      "compute.rpi5"
    ],
    "twin_controls": []
  },
  "metadata": {
    "image_url": "https://upload.wikimedia.org/wikipedia/commons/thumb/4/4b/DHT11-Module.jpg/640px-DHT11-Module.jpg",
    "datasheet_url": "https://www.mouser.com/datasheet/2/758/DHT11-Technical-Data-Sheet-Translated-Version-1143054.pdf",
    "brand_variants": [
      "Aosong DHT11",
      "KY-015 module",
      "HiLetGo DHT11"
    ],
    "price_usd_range": [
      1,
      4
    ],
    "source": "tools/seed_catalog.py"
  }
