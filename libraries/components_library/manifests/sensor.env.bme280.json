{
  "stable_id": "sensor.env.bme280",
  "name": "BME280 Temp / Humidity / Pressure Sensor",
  "vendor": "Bosch Sensortec",
  "version": "1.1.0",
  "library": "components_library",
  "category": "sensors",
  "subcategory": "environment",
  "description": "Three-in-one combined sensor over I2C/SPI. Temp ±1°C, humidity ±3% RH, pressure ±1hPa. Tiny, low-power (~3µA), high accuracy. Industry workhorse for weather stations + indoor air quality.",
  "tags": [
    "temperature",
    "humidity",
    "pressure",
    "altitude",
    "i2c",
    "spi",
    "bosch"
  ],
  "capabilities": [
    "temperature_read",
    "humidity_read",
    "pressure_read",
    "altitude_compute"
  ],
  "dependencies": [],
  "interfaces": [
    {
      "type": "I2C",
      "direction": "bidir",
      "address": "0x76 or 0x77",
      "speed_hz": 400000,
      "voltage": 3.3
    },
    {
      "type": "SPI",
      "direction": "bidir",
      "voltage": 3.3
    }
  ],
  "power": {
    "voltage_v": 3.3,
    "voltage_tolerance_pct": 10,
    "current_ma_typical": 0.4,
    "current_ma_peak": 0.7,
    "power_source": "bus"
  },
  "safety_class": "advisory",
  "drivers": [
    {
      "runtime": "micropython",
      "module": "bme280",
      "version_range": ">=0.1.0"
    }
  ],
  "self_tests": [
    {
      "id": "presence",
      "name": "BME280 Temp / Humidity / Pressure Sensor reachable",
      "blocking": false,
      "steps": [
        "read once",
        "expect no driver error"
      ],
      "expected": "no error"
    }
  ],
  "compatibility": {
    "compute": [
      "compute.pico2w",
      "compute.rpi5"
    ],
    "twin_controls": []
  },
  "metadata": {
    "image_url": "https://upload.wikimedia.org/wikipedia/commons/thumb/d/d6/BME280_Sensor_Front.jpg/640px-BME280_Sensor_Front.jpg",
    "datasheet_url": "https://www.bosch-sensortec.com/media/boschsensortec/downloads/datasheets/bst-bme280-ds002.pdf",
    "brand_variants": [
      "Bosch BME280",
      "Adafruit 2652",
      "GY-BME280"
    ],
    "price_usd_range": [
      5,
      18
    ],
    "source": "tools/seed_catalog.py"
  }
}
