    "infrared",
    "non-contact",
    "i2c"
  ],
  "capabilities": [
    "temperature_read"
  ],
  "dependencies": [],
  "interfaces": [
    {
      "type": "I2C",
      "direction": "bidir",
      "address": "0x5A",
      "speed_hz": 100000,
      "voltage": 3.3
    }
  ],
  "power": {
    "voltage_v": 3.3,
    "voltage_tolerance_pct": 10,
    "current_ma_typical": 1.5,
    "current_ma_peak": 2.5,
    "power_source": "bus"
  },
  "safety_class": "advisory",
  "drivers": [
    {
      "runtime": "micropython",
      "module": "mlx90614",
      "version_range": ">=0.1.0"
    }
