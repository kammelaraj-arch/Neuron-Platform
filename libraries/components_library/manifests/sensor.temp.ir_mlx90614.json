{
  "stable_id": "sensor.temp.ir_mlx90614",
  "name": "MLX90614 Non-Contact IR Temperature Sensor",
  "vendor": "Melexis",
  "version": "1.0.0",
  "library": "components_library",
  "category": "sensors",
  "subcategory": "temperature",
  "description": "Non-contact infrared thermometer over I2C. Object temp -70~380°C, ±0.5°C in human-body range. Used for contactless surface temperature, body temp screening, hot-surface alarms.",
