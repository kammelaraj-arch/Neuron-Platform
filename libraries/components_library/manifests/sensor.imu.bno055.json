{
  "stable_id": "sensor.imu.bno055",
  "name": "BNO055 Absolute 9-DOF Orientation Sensor",
  "vendor": "Bosch Sensortec",
  "version": "1.0.0",
  "library": "components_library",
  "category": "sensors",
  "subcategory": "imu",
  "description": "Accelerometer + gyroscope + magnetometer with on-chip sensor fusion producing absolute quaternion orientation. Just read angles — no Madgwick / Kalman math needed. Use for stabilized cameras, robotic arm pose, AR/VR demos.",
