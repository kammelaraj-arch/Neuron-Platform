    "imu",
    "9dof",
    "fusion",
    "quaternion",
    "i2c"
  ],
  "capabilities": [
    "orientation_read",
    "acceleration_read",
    "rotation_read",
    "compass_read"
  ],
  "dependencies": [],
  "interfaces": [
    {
      "type": "I2C",
      "direction": "bidir",
      "address": "0x28 or 0x29",
      "speed_hz": 400000,
      "voltage": 3.3
    }
  ],
  "power": {
    "voltage_v": 3.3,
    "voltage_tolerance_pct": 10,
    "current_ma_typical": 12.3,
    "current_ma_peak": 13,
    "power_source": "bus"
  },
  "safety_class": "advisory",
