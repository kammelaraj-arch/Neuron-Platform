{
  "stable_id": "sensor.pressure.bmp280",
  "name": "BMP280 Barometric Pressure + Temperature",
  "vendor": "Bosch Sensortec",
  "version": "1.0.0",
  "library": "components_library",
  "category": "sensors",
  "subcategory": "environment",
  "description": "Pressure-only sibling of BME280 (no humidity). I2C/SPI, ±1hPa abs, ±0.12hPa relative. Use for altitude estimation, weather, air-tightness leak detection.",
