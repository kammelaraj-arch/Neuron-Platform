    "barometer",
    "i2c",
    "spi",
    "bosch"
  ],
  "capabilities": [
    "pressure_read",
    "temperature_read",
    "altitude_compute"
  ],
  "dependencies": [],
  "interfaces": [
    {
      "type": "I2C",
      "direction": "bidir",
      "address": "0x76 or 0x77",
      "speed_hz": 400000,
      "voltage": 3.3
    }
  ],
  "power": {
    "voltage_v": 3.3,
    "voltage_tolerance_pct": 10,
    "current_ma_typical": 0.3,
    "current_ma_peak": 0.7,
    "power_source": "bus"
  },
  "safety_class": "advisory",
  "drivers": [],
