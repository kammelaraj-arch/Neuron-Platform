      "steps": [
        "read once",
        "expect no driver error"
      ],
      "expected": "no error"
    }
  ],
  "compatibility": {
    "compute": [
      "compute.pico2w",
      "compute.rpi5"
    ],
    "twin_controls": []
  },
  "metadata": {
    "image_url": "https://www.adafruit.com/product/393",
