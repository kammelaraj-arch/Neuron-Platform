    "temperature",
    "humidity",
    "1-wire-style",
    "low-power"
  ],
  "capabilities": [
    "temperature_read",
    "humidity_read"
  ],
  "dependencies": [],
  "interfaces": [
    {
      "type": "GPIO",
      "direction": "bidir",
      "pins_required": 1,
      "voltage": 3.3
    }
  ],
  "power": {
    "voltage_v": 3.3,
    "voltage_tolerance_pct": 10,
    "current_ma_typical": 1.5,
    "current_ma_peak": 2.5,
    "power_source": "bus"
  },
  "safety_class": "advisory",
  "drivers": [
    {
      "runtime": "micropython",
      "module": "dht",
      "version_range": ">=0.1.0"
    }
  ],
  "self_tests": [
    {
      "id": "presence",
      "name": "DHT22 / AM2302 Temperature & Humidity Sensor reachable",
