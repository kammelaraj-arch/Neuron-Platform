{
  "stable_id": "sensor.temp_humid.dht22",
  "name": "DHT22 / AM2302 Temperature & Humidity Sensor",
  "vendor": "Aosong",
  "version": "1.0.0",
  "library": "components_library",
  "category": "sensors",
  "subcategory": "environment",
  "description": "Digital temperature (-40~80°C, ±0.5°C) + humidity (0-100% RH, ±2%) on a single wire. Slow (1Hz max) but accurate. Industry standard for HVAC, greenhouses, climate monitoring.",
