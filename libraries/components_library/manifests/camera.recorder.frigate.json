{
  "stable_id": "camera.recorder.frigate",
  "name": "Frigate NVR Recorder",
  "vendor": "Open Source",
  "version": "1.0.0",
  "library": "components_library",
  "category": "cameras",
  "subcategory": "recorder",
  "description": "Frigate NVR — open-source recorder with optional Coral TPU detection. Records RTSP streams to disk with configurable retention and event clipping. Pairs naturally with the Tapo cameras above.",
  "tags": ["recorder", "nvr", "frigate", "rtsp", "ai", "coral"],
  "image": { "asset": "../cameras/frigate_recorder.svg", "alt": "Frigate NVR" },
  "capabilities": ["record_rtsp", "event_clip", "object_detection", "retention_policy"],
  "dependencies": [
    { "stable_id": "compute.rpi5", "version_range": ">=1.0.0", "optional": true },
    { "stable_id": "compute.ai_edge.coral", "version_range": ">=1.0.0", "optional": true }
  ],
  "interfaces": [
    { "type": "HTTP", "direction": "bidir", "notes": "MQTT + REST control surface" },
    { "type": "Ethernet", "direction": "bidir" }
  ],
  "power": {
    "voltage_v": 5,
    "current_ma_typical": 1500,
    "current_ma_peak": 5000,
    "power_source": "external"
  },
  "safety_class": "nominal",
  "drivers": [
    { "runtime": "linux_pkg", "module": "docker.io", "version_range": ">=24.0" }
  ],
  "self_tests": [
    { "id": "container_up", "name": "Frigate container healthy",
      "blocking": true,
      "steps": ["curl -fsS http://localhost:5000/api/version"],
      "expected": "200 OK" },
    { "id": "disk_writable", "name": "Recording dir writable",
      "steps": ["touch /media/frigate/test"],
      "expected": "no error" }
  ],
  "compatibility": {
    "compute": ["compute.rpi5", "compute.ai_edge.coral"],
    "twin_controls": ["twin.recorder_control"]
  },
  "metadata": {
    "default_retention_days": 7,
    "supported_codecs": ["h264", "h265"],
    "ai_accelerator": "optional (Coral TPU)"
  }
}
