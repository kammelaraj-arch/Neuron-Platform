{
  "stable_id": "twin.motor_control",
  "name": "Motor Control",
  "vendor": "Neuron Platform",
  "version": "1.0.0",
  "library": "digital_twin_controls_library",
  "category": "controls",
  "description": "Motor twin with start/stop/speed and fault state. Drives DC motor or servo via mapped board.",
  "tags": ["motor", "twin"],
  "image": { "asset": "../controls/motor_control.svg", "alt": "Motor control twin" },
  "capabilities": ["start_stop", "speed_setpoint", "direction", "fault_state"],
  "interfaces": [{ "type": "Internal", "direction": "bidir" }],
  "power": { "voltage_v": 0, "current_ma_typical": 0, "power_source": "bus" },
  "safety_class": "advisory",
  "drivers": [],
  "self_tests": [
    { "id": "fsm_reset", "name": "FSM enters STOPPED on reset", "blocking": true, "steps": ["reset", "state==STOPPED"], "expected": "STOPPED" }
  ],
  "compatibility": {
    "compute": ["compute.pico2w", "compute.rpi5"],
    "ui_widgets": ["ui.widget.motor_status"]
  },
  "metadata": {
    "state_machine": {
      "states": ["STOPPED", "STARTING", "RUNNING", "STOPPING", "FAULT"],
      "transitions": [
        { "from": "STOPPED", "to": "STARTING", "on": "start" },
        { "from": "STARTING", "to": "RUNNING", "on": "speed_reached" },
        { "from": "RUNNING", "to": "STOPPING", "on": "stop" },
        { "from": "STOPPING", "to": "STOPPED", "on": "speed_zero" },
        { "from": "*", "to": "FAULT", "on": "fault" }
      ]
    },
    "desired": {
      "speed_pct": { "type": "number", "min": 0, "max": 100 },
      "direction": { "type": "string", "enum": ["fwd", "rev"] },
      "command": { "type": "string", "enum": ["start", "stop", "ack"] }
    },
    "reported": {
      "speed_pct": { "type": "number" },
      "state": { "type": "string" },
      "fault_code": { "type": "string" }
    },
    "current": {
      "current_a": { "type": "number" },
      "alarm_active": { "type": "boolean" }
    }
  }
}
