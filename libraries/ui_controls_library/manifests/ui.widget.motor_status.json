{
  "stable_id": "ui.widget.motor_status",
  "name": "Motor Status Widget",
  "vendor": "Neuron Platform",
  "version": "1.0.0",
  "library": "ui_controls_library",
  "category": "widgets",
  "description": "Compact run/fault status tile with speed bar, direction arrow, fault code.",
  "tags": ["motor", "status"],
  "image": { "asset": "../symbols_svg/motor.svg", "alt": "Motor status widget" },
  "capabilities": ["render_status", "render_speed", "render_direction", "mobile_responsive"],
  "interfaces": [{ "type": "Internal", "direction": "bidir" }],
  "power": { "voltage_v": 0, "current_ma_typical": 0, "power_source": "bus" },
  "safety_class": "nominal",
  "drivers": [
    { "runtime": "node", "module": "@neuron/ui-widgets", "version_range": ">=1.0.0" }
  ],
  "self_tests": [
    { "id": "renders", "name": "Mounts without error", "steps": ["mount in dom"], "expected": "no exceptions" }
  ],
  "compatibility": {
    "twin_controls": ["twin.motor_control"]
  },
  "ui_bindings": [
    { "widget_id": "ui.widget.motor_status", "binding": "$.reported.state" },
    { "widget_id": "ui.widget.motor_status", "binding": "$.reported.speed_pct" },
    { "widget_id": "ui.widget.motor_status", "binding": "$.reported.fault_code" }
  ]
}
