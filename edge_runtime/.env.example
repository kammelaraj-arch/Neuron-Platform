# Edge Runtime configuration. Defaults assume a single-site Linux edge host
# (e.g. a Raspberry Pi 5 running Docker) on a private factory LAN.

EDGE_DB_URL=sqlite+aiosqlite:///./data/edge.db
EDGE_POLICY_PATH=./policies/edge_default.json
EDGE_BIND_HOST=0.0.0.0
EDGE_BIND_PORT=8090

# Identity of this edge instance — must match the master's edge_systems entry.
EDGE_ID=edge-default
EDGE_SITE_ID=site-default
EDGE_PARENT_NODE_URL=https://neuron.shital.org.uk

# Push twin updates to the Master the moment they change (zero-lag SSE).
# Leave blank to disable; the Master will fall back to its slow on-demand
# poll. Set MASTER_PUSH_API_KEY to an X-API-Key with the devices:write scope.
EDGE_MASTER_PUSH_URL=https://neuron.shital.org.uk
EDGE_MASTER_PUSH_API_KEY=

# mTLS — paths to PEM files mounted into the container.
EDGE_TLS_ENABLED=false
EDGE_TLS_CERT_PATH=./certs/edge.crt
EDGE_TLS_KEY_PATH=./certs/edge.key
EDGE_TLS_CA_PATH=./certs/parent_ca.crt

# Local Mosquitto broker. When the docker-compose stack starts, set
# MQTT_HOST=mosquitto (the service name in the same compose) so the
# Edge bridges its twin cache to MQTT. Pico 2 W devices publish/subscribe
# directly to topics like:
#   twin/<kind>/<dna>/{desired,reported,current}/<field>
#   device/<dna>/heartbeat
# Leave blank to keep the legacy REST-only path.
EDGE_MQTT_HOST=mosquitto
EDGE_MQTT_PORT=1883
EDGE_MQTT_CLIENT_ID=neuron-edge

# Tapo plugs on the local LAN. Either set this env var (JSON list) or
# drop a tapo_devices.json file in the edge_data volume with the same
# shape:
#   [{"device_dna": "DNA-...", "host": "192.168.1.42",
#     "email": "you@example.com", "password": "<plug-pw>"}]
EDGE_TAPO_DEVICES=

EDGE_LOG_LEVEL=info
