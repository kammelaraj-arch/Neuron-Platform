# Neuron Platform — Master configuration.
#
# IMPORTANT: This database is fully INDEPENDENT from the ShitalEco backend.
#   - ShitalEco backend uses Postgres via DATABASE_URL (no NEURON_ prefix).
#   - Neuron Master uses its own SQLite (or Postgres) via NEURON_DB_URL.
# Never point NEURON_DB_URL at the ShitalEco database — startup will refuse.
#
# There is NO env variable for the bootstrap admin key by design. On first
# boot, the Master auto-issues an admin key, writes the plaintext (once)
# to ./data/bootstrap_admin.txt (chmod 0600), and from then on every key
# is managed through the in-app Secrets section at /ui/secrets.
NEURON_DB_URL=sqlite+aiosqlite:///./data/neuron.db
NEURON_LIBRARIES_DIR=../libraries
NEURON_SHARED_SCHEMAS_DIR=../shared_schemas
NEURON_BUILD_ARTIFACTS_DIR=./build_artifacts
NEURON_BIND_HOST=0.0.0.0
NEURON_BIND_PORT=8088
NEURON_LOG_LEVEL=info

# Audit retention — events older than this many days are pruned hourly.
NEURON_AUDIT_KEEP_DAYS=90
