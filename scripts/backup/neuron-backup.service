[Unit]
Description=Neuron Master nightly backup (SQLite + data dir → tar.gz)
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/neuron-backup
ExecStart=/usr/local/bin/neuron-backup.sh
User=root
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
StandardOutput=journal
StandardError=journal
