{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://neuron.shital.org.uk/schemas/dna.schema.json",
  "title": "Neuron Device DNA",
  "description": "Immutable identity + capability record for a Level 0/1 device. Generated by Master, mirrored on device.",
  "type": "object",
  "required": [
    "device_dna",
    "device_type",
    "compute_stable_id",
    "hardware_revision",
    "base_firmware_version",
    "app_bundle_version",
    "config_schema_version",
    "parent_node_id",
    "site_id",
    "issued_at",
    "issued_by",
    "components",
    "fingerprint"
  ],
  "additionalProperties": false,
  "properties": {
    "device_dna": {
      "type": "string",
      "pattern": "^DNA-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}$",
      "description": "Globally unique device DNA id."
    },
    "device_type": { "type": "string", "enum": ["pico2w", "linux_edge", "ai_edge", "gateway"] },
    "compute_stable_id": { "type": "string" },
    "board_stable_id": { "type": "string" },
    "hardware_revision": { "type": "string" },
    "serial_number": { "type": "string" },
    "mac_address": { "type": "string", "pattern": "^[0-9A-Fa-f:]{17}$" },
    "base_firmware_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "app_bundle_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "config_schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "parent_node_id": { "type": "string" },
    "site_id": { "type": "string" },
    "issued_at": { "type": "string", "format": "date-time" },
    "issued_by": { "type": "string" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stable_id", "instance_id", "version"],
        "additionalProperties": false,
        "properties": {
          "stable_id": { "type": "string" },
          "instance_id": { "type": "string" },
          "version": { "type": "string" },
          "role": { "type": "string" }
        }
      }
    },
    "twin_controls": {
      "type": "array",
      "items": { "type": "string" }
    },
    "fingerprint": {
      "type": "object",
      "required": ["alg", "hash"],
      "additionalProperties": false,
      "properties": {
        "alg": { "type": "string", "enum": ["sha256", "sha512"] },
        "hash": { "type": "string" },
        "signature": { "type": "string", "description": "Detached signature over the DNA blob (base64)." },
        "signer_kid": { "type": "string" }
      }
    },
    "metadata": { "type": "object", "additionalProperties": true }
  }
}
