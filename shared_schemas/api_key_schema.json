{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://neuron.shital.org.uk/schemas/api_key.schema.json",
  "title": "Neuron API Key",
  "type": "object",
  "required": ["id", "owner", "scopes", "issued_at", "status", "hash_alg", "key_hash"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "label": { "type": "string" },
    "owner": { "type": "string", "description": "User or service principal id." },
    "tier": { "type": "string", "enum": ["admin", "integration", "device", "readonly"] },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*(:(read|write|admin))?$" }
    },
    "rate_limit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests_per_minute": { "type": "integer", "minimum": 1 },
        "burst": { "type": "integer", "minimum": 1 }
      }
    },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "rotated_from": { "type": "string" },
    "status": { "type": "string", "enum": ["active", "rotated", "revoked", "expired"] },
    "hash_alg": { "type": "string", "enum": ["argon2id", "sha256_hmac"] },
    "key_hash": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  }
}
