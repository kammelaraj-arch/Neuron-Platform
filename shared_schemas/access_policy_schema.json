{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://neuron.shital.org.uk/schemas/access_policy.schema.json",
  "title": "Neuron Edge Access Policy",
  "description": "Authoritative allow-list policy enforced by the Edge Gateway. Default is deny.",
  "type": "object",
  "required": ["policy_version", "issued_at", "edge_id", "inbound", "outbound", "mqtt_acl", "emergency"],
  "additionalProperties": false,
  "properties": {
    "policy_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "issued_at": { "type": "string", "format": "date-time" },
    "edge_id": { "type": "string" },
    "inbound": {
      "type": "object",
      "required": ["default", "allow"],
      "additionalProperties": false,
      "properties": {
        "default": { "type": "string", "enum": ["deny"] },
        "allow": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["principal", "cidr", "purpose"],
            "additionalProperties": false,
            "properties": {
              "principal": { "type": "string", "enum": ["parent_node", "emergency", "local_device"] },
              "cidr": { "type": "string" },
              "ports": { "type": "array", "items": { "type": "integer" } },
              "mtls_required": { "type": "boolean", "default": true },
              "cert_fingerprints_sha256": { "type": "array", "items": { "type": "string", "pattern": "^[A-Fa-f0-9:]{59,}$" } },
              "purpose": { "type": "string" }
            }
          }
        }
      }
    },
    "outbound": {
      "type": "object",
      "required": ["default", "allow"],
      "additionalProperties": false,
      "properties": {
        "default": { "type": "string", "enum": ["deny"] },
        "allow": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["principal", "host", "purpose"],
            "additionalProperties": false,
            "properties": {
              "principal": { "type": "string", "enum": ["parent_node", "master", "emergency"] },
              "host": { "type": "string" },
              "ports": { "type": "array", "items": { "type": "integer" } },
              "mtls_client_cert_kid": { "type": "string" },
              "purpose": { "type": "string" }
            }
          }
        }
      }
    },
    "mqtt_acl": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["principal", "topic", "permission"],
        "additionalProperties": false,
        "properties": {
          "principal": { "type": "string" },
          "topic": { "type": "string" },
          "permission": { "type": "string", "enum": ["pub", "sub", "pubsub"] }
        }
      }
    },
    "emergency": {
      "type": "object",
      "required": ["enabled", "command_set"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "channel": { "type": "string", "default": "mqtts://emergency" },
        "cert_kid": { "type": "string" },
        "command_set": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["safe_stop", "safe_shutdown", "status"] }
        }
      }
    }
  }
}
