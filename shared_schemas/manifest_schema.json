{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://neuron.shital.org.uk/schemas/manifest.schema.json",
  "title": "Neuron Platform Library Item Manifest",
  "description": "Universal manifest schema applied to every library item across all libraries (hardware, twin, ui, business, functional, api).",
  "type": "object",
  "required": [
    "stable_id",
    "name",
    "vendor",
    "version",
    "library",
    "category",
    "capabilities",
    "interfaces",
    "power",
    "safety_class",
    "drivers",
    "self_tests",
    "compatibility"
  ],
  "additionalProperties": false,
  "properties": {
    "stable_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_\\-\\.]{2,63}$",
      "description": "Globally unique, immutable id (e.g. 'sensor.temp.ds18b20')."
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "vendor": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[\\-+][\\w\\.\\-]+)?$",
      "description": "SemVer 2.0.0"
    },
    "library": {
      "type": "string",
      "enum": [
        "components_library",
        "control_board_library",
        "micro_compute_library",
        "digital_twin_controls_library",
        "ui_controls_library",
        "business_library",
        "functional_library",
        "api_library"
      ]
    },
    "category": { "type": "string", "minLength": 1 },
    "subcategory": { "type": "string" },
    "description": { "type": "string", "maxLength": 2000 },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset": { "type": "string", "description": "Relative path to image (png/svg) within the library." },
        "alt": { "type": "string" },
        "thumbnail": { "type": "string" }
      }
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true,
      "description": "What this item can do/provide (e.g. 'temperature_read', 'pwm_out', 'mqtt')."
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stable_id", "version_range"],
        "additionalProperties": false,
        "properties": {
          "stable_id": { "type": "string" },
          "version_range": { "type": "string", "description": "SemVer range (e.g. '>=1.0.0 <2.0.0')." },
          "optional": { "type": "boolean", "default": false }
        }
      }
    },
    "interfaces": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["GPIO", "ADC", "DAC", "PWM", "I2C", "SPI", "UART", "USB", "Ethernet", "WiFi", "BLE", "CAN", "1-Wire", "MQTT", "HTTP", "WebSocket", "Internal"]
          },
          "direction": { "type": "string", "enum": ["in", "out", "bidir"] },
          "pins_required": { "type": "integer", "minimum": 0 },
          "address": { "type": "string", "description": "I2C address, SPI CS, UART path, etc." },
          "speed_hz": { "type": "integer", "minimum": 0 },
          "voltage": { "type": "number", "minimum": 0 },
          "notes": { "type": "string" }
        }
      }
    },
    "power": {
      "type": "object",
      "required": ["voltage_v", "current_ma_typical"],
      "additionalProperties": false,
      "properties": {
        "voltage_v": { "type": "number", "minimum": 0 },
        "voltage_tolerance_pct": { "type": "number", "minimum": 0 },
        "current_ma_typical": { "type": "number", "minimum": 0 },
        "current_ma_peak": { "type": "number", "minimum": 0 },
        "power_source": { "type": "string", "enum": ["bus", "external", "poe", "battery", "mains"] }
      }
    },
    "safety_class": {
      "type": "string",
      "enum": ["nominal", "advisory", "critical", "life_safety"],
      "description": "Drives default ACL/alarm latching behaviour at edge."
    },
    "drivers": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["runtime", "module"],
        "additionalProperties": false,
        "properties": {
          "runtime": { "type": "string", "enum": ["micropython", "cpython", "linux_pkg", "node"] },
          "module": { "type": "string", "description": "Importable module name or apt/pip package name." },
          "version_range": { "type": "string" },
          "init_args": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "self_tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "steps"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "blocking": { "type": "boolean", "default": false },
          "steps": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "expected": { "type": "string" }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "boards": { "type": "array", "items": { "type": "string" } },
        "compute": { "type": "array", "items": { "type": "string" } },
        "twin_controls": { "type": "array", "items": { "type": "string" } },
        "ui_widgets": { "type": "array", "items": { "type": "string" } }
      }
    },
    "twin_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["control_id", "channel"],
        "additionalProperties": false,
        "properties": {
          "control_id": { "type": "string" },
          "channel": { "type": "string", "enum": ["desired", "reported", "current"] },
          "field": { "type": "string" },
          "scale": { "type": "number" },
          "offset": { "type": "number" },
          "units": { "type": "string" }
        }
      }
    },
    "ui_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["widget_id", "binding"],
        "additionalProperties": false,
        "properties": {
          "widget_id": { "type": "string" },
          "binding": { "type": "string", "description": "JSONPath/twin field reference." },
          "format": { "type": "string" }
        }
      }
    },
    "metadata": { "type": "object", "additionalProperties": true }
  }
}
